{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform-neutral Workspace and State Contract",
  "type": "object",
  "required": ["contract_version", "workspace", "state"],
  "properties": {
    "contract_version": {"type": "integer", "const": 1},
    "schema": {"type": "string", "minLength": 1},
    "workspace": {
      "type": "object",
      "required": ["requirement", "persistence", "portable", "separate_from_assistant"],
      "properties": {
        "requirement": {
          "enum": ["required", "recommended", "optional", "not_required"]
        },
        "persistence": {
          "enum": ["required", "preferred", "ephemeral", "not_required"]
        },
        "portable": {"type": "boolean"},
        "separate_from_assistant": {"type": "boolean"},
        "artifact": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["requirement", "persistence", "authority"],
      "properties": {
        "requirement": {
          "enum": ["required", "recommended", "optional", "not_required"]
        },
        "persistence": {
          "enum": ["required", "preferred", "ephemeral", "not_required"]
        },
        "authority": {
          "enum": ["workspace_file", "conversation", "runtime_managed", "none"]
        },
        "format": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "conversation_fallback": {"type": "boolean"},
        "description": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"authority": {"const": "workspace_file"}},
            "required": ["authority"]
          },
          "then": {
            "required": ["format", "path"]
          }
        }
      ],
      "additionalProperties": false
    },
    "runtime_preferences": {
      "type": "object",
      "additionalProperties": {
        "enum": ["workspace_file", "conversation_or_file", "runtime_managed", "none"]
      }
    }
  },
  "additionalProperties": false
}
