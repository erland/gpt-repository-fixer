{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository-fixer.local/schemas/repository-fix-plan.schema.json",
  "title": "Repository Fixer Fix Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository_name", "source_finding_ids", "steps", "notes"],
  "properties": {
    "repository_name": {"type": "string", "minLength": 1},
    "source_finding_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^RF-[A-Z0-9][A-Z0-9-]*-[0-9]{3}$"},
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/step"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "question"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^RF-[A-Z0-9][A-Z0-9-]*-[0-9]{3}$"},
        "question": {"type": "string", "minLength": 1}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "goal", "why", "finding_ids", "likely_files", "planned_changes",
        "decisions", "verification", "risk", "dependencies", "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^STEP-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^RF-[A-Z0-9][A-Z0-9-]*-[0-9]{3}$"},
          "uniqueItems": true
        },
        "likely_files": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "planned_changes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "risk": {"enum": ["low", "medium", "high"]},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "pattern": "^STEP-[0-9]{2}$"},
          "uniqueItems": true
        },
        "status": {"enum": ["planned", "completed", "skipped", "blocked"]}
      }
    }
  }
}
